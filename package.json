{
  "name": "advisortrack-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AdvisorTrack Management Portal",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "test:pipeline-drilldown": "npx --yes tsx scripts/verify-pipeline-drilldown.ts",
    "test:advisor-drilldown": "npx --yes tsx scripts/verify-advisor-drilldown-click.ts",
    "test:demo-dashboard": "npx --yes tsx scripts/verify-demo-dashboard.ts",
    "engineering:context": "npx --yes tsx scripts/engineering-context.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
