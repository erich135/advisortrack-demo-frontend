{
  "name": "advisortrack-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AdvisorTrack Management Portal",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "test:pipeline-drilldown": "npx --yes tsx scripts/verify-pipeline-drilldown.ts",
    "test:advisor-drilldown": "npx --yes tsx scripts/verify-advisor-drilldown-click.ts",
    "test:sticky-scroll": "npx --yes tsx scripts/verify-sticky-horizontal-scroll.ts",
    "test:demo-dashboard": "npx --yes tsx scripts/verify-demo-dashboard.ts",
    "test:permission-denied": "npx --yes tsx scripts/verify-permission-denied.ts",
    "test:company-context": "npx --yes tsx scripts/verify-company-context.ts",
    "test:licence-dashboard": "npx --yes tsx scripts/verify-licence-dashboard.ts",
    "test:seat-increase": "npx --yes tsx scripts/verify-seat-increase.ts",
    "test:add-user": "npx --yes tsx scripts/verify-add-user.ts",
    "test:offboarding": "npx --yes tsx scripts/verify-offboarding.ts",
    "test:invitations": "npx --yes tsx scripts/verify-invitations.ts",
    "test:bulk-import": "npx --yes tsx scripts/verify-bulk-import.ts",
    "test:enterprise-contract": "npx --yes tsx scripts/verify-enterprise-contract.ts",
    "test:demo-enterprise-parity": "npx --yes tsx scripts/verify-demo-enterprise-parity.ts",
    "test:navigation": "npx --yes tsx scripts/verify-navigation.ts",
    "test:assistant-ui": "npx --yes tsx scripts/verify-assistant-ui.ts",
    "test:assistant-context": "npx --yes tsx scripts/verify-assistant-context.ts",
    "test:assistant-retrieve": "npx --yes tsx scripts/verify-assistant-retrieve.ts",
    "test:assistant-ask": "npx --yes tsx scripts/verify-assistant-ask.ts",
    "test:draft-invoices": "npx --yes tsx scripts/verify-draft-invoices.ts",
    "engineering:context": "npx --yes tsx scripts/engineering-context.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
